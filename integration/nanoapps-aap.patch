@@ -130,6 +156,41 @@ void lv_surface_frame(void)
    Exposed so an app's frame cb can target it with hardware 2D (hb_compositor). */
 static void *s_fb;
 static int   s_fbw, s_fbh;
+
+#ifdef HB_LV_BACKBUF
+/* hb_lv_present565 (HB_LV_BACKBUF apps): put a window of a ready-made RGB565 picture on the display
+ * directly, without LVGL's renderer. `pic` is the picture (row stride `stride` bytes, `pic_h` rows); the
+ * display shows rows sy .. sy+height-1. LVGL's generic RGB565 -> XRGB8888 image blend costs ~190 ns per
+ * pixel on the device (three multiplies and three byte stores per pixel), a full screen of it ~19 ms; this
+ * reads two pixels per word and writes whole words, so the cost is about that of writing display memory.
+ * The caller must keep LVGL from drawing meanwhile (lv_display_enable_invalidation(disp, false)) and
+ * invalidate the screen when it hands the display back. */
+/* RGB565 -> XRGB8888 with the SAME rounding as LVGL's own blend ((r5 * 2106) >> 8, (g6 * 1037) >> 8), through
+ * three small tables, so a presented frame and a frame LVGL draws from the same picture agree to the pixel. */
+static unsigned int s_pr[32], s_pg[64], s_pb5[32];
+static int s_ptab;
+void hb_lv_present565(const void *pic, int stride, int pic_h, int sy)
+{
+    int fw = s_fbw, fh = s_fbh, y, x;
+    if (!s_fb || !pic || (fw & 1) || (stride & 3)) return;
+    if (!s_ptab) {
+        for (x = 0; x < 32; x++) { s_pr[x] = (unsigned int)((x * 2106) >> 8) << 16; s_pb5[x] = (unsigned int)((x * 2106) >> 8); }
+        for (x = 0; x < 64; x++) s_pg[x] = (unsigned int)((x * 1037) >> 8) << 8;
+        s_ptab = 1;
+    }
+    if (sy + fh > pic_h) sy = pic_h - fh;
+    if (sy < 0) return;
+    for (y = 0; y < fh; y++) {
+        const unsigned int *src = (const unsigned int *)((const unsigned char *)pic + (unsigned)(sy + y) * (unsigned)stride);
+        unsigned int *o = (unsigned int *)s_fb + (unsigned)y * (unsigned)fw;
+        for (x = 0; x < fw / 2; x++) {
+            unsigned int two = src[x], a = two & 0xffffu, b = two >> 16;
+            o[2 * x]     = 0xff000000u | s_pr[a >> 11] | s_pg[(a >> 5) & 63u] | s_pb5[a & 31u];
+            o[2 * x + 1] = 0xff000000u | s_pr[b >> 11] | s_pg[(b >> 5) & 63u] | s_pb5[b & 31u];
+        }
+    }
+}
+#endif
 #ifdef HB_LV_COMPOSITOR
 static void *s_pb;   /* GPU pixel buffer handle backing s_draw */
 #endif
